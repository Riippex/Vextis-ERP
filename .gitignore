# -----------------------------------------------------------------------------
# Private project material
# -----------------------------------------------------------------------------
# Internal notes, drafts, research, credentials guidance, private planning, etc.
# Public/judge-facing documentation belongs in /docs instead.
/documents/

# Local AI-assistant state and private instructions
/.claude/*
!/.claude/skills/
!/.claude/skills/**
/.gemini/
/.codex/
/.agents/*
!/.agents/skills/
!/.agents/skills/**
CLAUDE.local.md
GEMINI.local.md
AGENTS.local.md

# -----------------------------------------------------------------------------
# Secrets and environment-specific configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
secrets/
**/secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*service-account*.json
application_default_credentials.json
gha-creds-*.json
application-local.yml
application-local.yaml
application-local.properties

