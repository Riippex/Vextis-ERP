# -----------------------------------------------------------------------------
# Terraform / Google Cloud local state
# -----------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
tfplan-*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
/.gcloud/
/.firebase/
firebase-debug.log*

# Keep Terraform dependency locks reproducible.
!.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Local knowledge-graph indices (codegraph, gitnexus, graphify)
# -----------------------------------------------------------------------------
# Machine-local caches/indices for AI-agent code navigation — regenerated by
# each agent/dev via `codegraph init`/`gitnexus analyze`, never source of truth.
.codegraph/
.gitnexus/
# Commit this one: recurring `gitnexus analyze` flags for the whole team.
!.gitnexusrc
# Working audit output from /graphify; promote specific findings into /docs
# by hand instead of committing the raw graph dump.
graphify-out/

