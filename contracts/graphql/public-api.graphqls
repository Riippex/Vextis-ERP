type Query {
  health: Health!
  execution(id: ID!): Execution
}

type Mutation {
  receivePurchaseOrder(input: ReceivePurchaseOrderInput!): PurchaseOrderReceipt!
  createLiveSession(input: CreateLiveSessionInput!): LiveSession!
  closeLiveSession(id: ID!): Boolean!
}

type Health {
  status: ServiceStatus!
}

enum ServiceStatus {
  UP
}

type Execution {
  id: ID!
  goal: String!
  state: ExecutionState!
  correlationId: String!
  createdAt: String!
  updatedAt: String!
  timeline: [ExecutionTimelineEntry!]!
  plan: ExecutionPlan
  readiness: ExecutionReadiness
}

type ExecutionPlan {
  summary: String!
  modelId: String!
  generatedAt: String!
  steps: [ExecutionPlanStep!]!
  orderLines: [ExtractedOrderLine!]!
  requestedPaymentTermsDays: Int!
}

type ExtractedOrderLine {
  sku: String!
  quantity: Int!
}

type ExecutionReadiness {
  evaluatedAt: String!
  checks: [ReadinessCheck!]!
}

type ReadinessCheck {
  department: PlanningDepartment!
  status: ReadinessStatus!
  detail: String!
}

enum ReadinessStatus {
  READY
  REVIEW_REQUIRED
}

type ExecutionPlanStep {
  sequence: Int!
  department: PlanningDepartment!
  objective: String!
  requiresApproval: Boolean!
}

enum PlanningDepartment {
  CRM_SALES
  INVENTORY_OPERATIONS
  FINANCE_BILLING
}

type ExecutionTimelineEntry {
  sequence: Int!
  type: TimelineEntryType!
  title: String!
  detail: String!
  occurredAt: String!
}

enum TimelineEntryType {
  RECEIVED
  STATUS_CHANGED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  COMPLETED
  FAILED
}

enum ExecutionState {
  RECEIVED
  PLANNING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

input ReceivePurchaseOrderInput {
  purchaseOrderNumber: String!
  customerName: String!
  documentUri: String!
  idempotencyKey: String!
}

type PurchaseOrderReceipt {
  purchaseOrder: PurchaseOrder!
  execution: Execution!
}

type PurchaseOrder {
  id: ID!
  purchaseOrderNumber: String!
  customerName: String!
  documentUri: String!
  receivedAt: String!
}

input CreateLiveSessionInput {
  conversationId: ID!
}

type LiveSession {
  id: ID!
  websocketUrl: String!
  sessionToken: String!
  expiresAt: String!
}
