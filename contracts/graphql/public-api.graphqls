type Query {
  health: Health!
  execution(id: ID!): Execution
  missionControl: MissionControl!
}

type MissionControl {
  executions: [MissionControlExecution!]!
  customers: [CustomerOverview!]!
  stockItems: [StockItemOverview!]!
  stockReservations: [StockReservationOverview!]!
  creditProfiles: [CreditProfileOverview!]!
}

type MissionControlExecution {
  id: ID!
  purchaseOrderNumber: String!
  customerName: String!
  state: ExecutionState!
  correlationId: String!
  updatedAt: String!
}

type CustomerOverview {
  id: ID!
  legalName: String!
  active: Boolean!
}

type StockItemOverview {
  sku: String!
  availableQuantity: Int!
}

type CreditProfileOverview {
  customerId: ID!
  customerName: String!
  standing: CreditStanding!
  maxPaymentTermsDays: Int!
}

enum CreditStanding {
  GOOD
  REVIEW
  BLOCKED
}

type Mutation {
  preparePurchaseOrderUpload(input: PreparePurchaseOrderUploadInput!): PurchaseOrderUpload!
  receivePurchaseOrder(input: ReceivePurchaseOrderInput!): PurchaseOrderReceipt!
  decideApproval(input: DecideApprovalInput!): Execution!
  upsertCustomer(input: UpsertCustomerInput!): CustomerOverview!
  setStockAvailability(input: SetStockAvailabilityInput!): StockItemOverview!
  upsertCreditProfile(input: UpsertCreditProfileInput!): CreditProfileOverview!
  createLiveSession(input: CreateLiveSessionInput!): LiveSession!
  closeLiveSession(id: ID!): Boolean!
}

input PreparePurchaseOrderUploadInput {
  fileName: String!
  contentType: String!
  sizeBytes: Int!
}

type PurchaseOrderUpload {
  uploadUrl: String!
  documentUri: String!
  expiresAt: String!
  formFields: [UploadFormField!]!
}

type UploadFormField {
  name: String!
  value: String!
}

input UpsertCustomerInput {
  id: ID
  legalName: String!
  active: Boolean!
}

input SetStockAvailabilityInput {
  sku: String!
  availableQuantity: Int!
}

input UpsertCreditProfileInput {
  customerId: ID!
  standing: CreditStanding!
  maxPaymentTermsDays: Int!
}

type Health {
  status: ServiceStatus!
}

enum ServiceStatus {
  UP
}

type Execution {
  id: ID!
  goal: String!
  state: ExecutionState!
  correlationId: String!
  createdAt: String!
  updatedAt: String!
  timeline: [ExecutionTimelineEntry!]!
  plan: ExecutionPlan
  readiness: ExecutionReadiness
  approval: WorkflowApproval
}

type StockReservationOverview {
  id: ID!
  orderId: ID!
  sku: String!
  quantity: Int!
  status: StockReservationStatus!
  createdAt: String!
}

enum StockReservationStatus {
  RESERVED
  RELEASED
  FULFILLED
}

type WorkflowApproval {
  id: ID!
  recommendation: String!
  status: ApprovalStatus!
  requestedBy: String!
  requestedAt: String!
  expiresAt: String!
  decidedBy: String
  decidedAt: String
  reason: String
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

input DecideApprovalInput {
  executionId: ID!
  approvalId: ID!
  decision: ApprovalDecision!
  reason: String
  idempotencyKey: String!
}

type ExecutionPlan {
  summary: String!
  modelId: String!
  generatedAt: String!
  steps: [ExecutionPlanStep!]!
  orderLines: [ExtractedOrderLine!]!
  requestedPaymentTermsDays: Int!
}

type ExtractedOrderLine {
  sku: String!
  quantity: Int!
}

type ExecutionReadiness {
  evaluatedAt: String!
  checks: [ReadinessCheck!]!
}

type ReadinessCheck {
  department: PlanningDepartment!
  status: ReadinessStatus!
  detail: String!
}

enum ReadinessStatus {
  READY
  REVIEW_REQUIRED
}

type ExecutionPlanStep {
  sequence: Int!
  department: PlanningDepartment!
  objective: String!
  requiresApproval: Boolean!
}

enum PlanningDepartment {
  CRM_SALES
  INVENTORY_OPERATIONS
  FINANCE_BILLING
}

type ExecutionTimelineEntry {
  sequence: Int!
  type: TimelineEntryType!
  title: String!
  detail: String!
  occurredAt: String!
}

enum TimelineEntryType {
  RECEIVED
  STATUS_CHANGED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  COMPLETED
  FAILED
}

enum ExecutionState {
  RECEIVED
  PLANNING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

input ReceivePurchaseOrderInput {
  purchaseOrderNumber: String!
  customerName: String!
  documentUri: String!
  idempotencyKey: String!
}

type PurchaseOrderReceipt {
  purchaseOrder: PurchaseOrder!
  execution: Execution!
}

type PurchaseOrder {
  id: ID!
  purchaseOrderNumber: String!
  customerName: String!
  documentUri: String!
  receivedAt: String!
}

input CreateLiveSessionInput {
  conversationId: ID!
}

type LiveSession {
  id: ID!
  websocketUrl: String!
  sessionToken: String!
  expiresAt: String!
}
